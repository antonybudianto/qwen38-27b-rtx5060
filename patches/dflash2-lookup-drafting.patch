+        draft_tokens,
+        draft_tokens.stride(0),
+        lookup_tokens,
+        lookup_tokens.stride(0),
+        match_len,
+        valid,
+        use,
+        idx_mapping,
+        idx_mapping_stride,
+        hits,
+        take_flags,
+        nmin,
+        nstrong,
+        agree_min,
+        nmin_tail,
+        long_min,
+        k if draft_block is None else draft_block,
+        k=k,
+        BLOCK_KT=triton.next_power_of_2(k),
+        num_warps=1,
+    )
